<!-- Bài viết đánh giá & Thông số kỹ thuật -->
<div class="row">
    <!-- Chi tiết sản phẩm -->
    <div class="col-lg-8 mb-4">
        <div class="bg-white p-4 rounded shadow-sm">
            <h4 class="fw-bold border-bottom pb-2 mb-3">Đặc điểm nổi bật</h4>
            <div class="product-description" style="line-height: 1.8;">
                <p><strong>MacBook Air M1 2020</strong> là một trong những chiếc laptop mỏng nhẹ được yêu thích nhất của Apple. Với con chip M1 do chính Apple thiết kế, máy mang lại hiệu năng vượt trội và thời lượng pin ấn tượng.</p>
                <img src="https://images.unsplash.com/photo-1611186871348-b1ce696e52c9?auto=format&fit=crop&w=800&q=80" alt="MacBook Air M1 Performance" class="img-fluid rounded mb-3 w-100">
                <h5>Thiết kế sang trọng, siêu mỏng nhẹ</h5>
                <p>Vẫn giữ nguyên thiết kế nhôm nguyên khối đặc trưng, MacBook Air M1 cực kỳ sang trọng và tinh tế. Trọng lượng chỉ 1.29 kg giúp bạn dễ dàng mang theo bất cứ đâu.</p>
                <h5>Hiệu năng đột phá với Apple M1</h5>
                <p>Chip M1 với tiến trình 5nm mang đến tốc độ xử lý CPU nhanh hơn 3.5 lần, đồ họa GPU nhanh hơn 5 lần so với thế hệ trước, xử lý mượt mà mọi tác vụ văn phòng, thiết kế đồ họa 2D, render video cơ bản.</p>
            </div>
            <div class="text-center mt-3">
                <button class="btn btn-outline-primary">Xem thêm bài viết <i class="bi bi-chevron-down"></i></button>
            </div>
        </div>
    </div>

    <!-- Thông số kỹ thuật -->
    <div class="col-lg-4">
        <div class="bg-white p-4 rounded shadow-sm sticky-top" style="top: 20px;">
            <h4 class="fw-bold border-bottom pb-2 mb-3">Thông số kỹ thuật</h4>
            <table class="table table-striped table-bordered mb-0">
                <tbody>
                    <tr>
                        <th scope="row" style="width: 40%;">Màn hình</th>
                        <td>13.3", Retina (2560 x 1600)</td>
                    </tr>
                    <tr>
                        <th scope="row">CPU</th>
                        <td>Apple M1</td>
                    </tr>
                    <tr>
                        <th scope="row">RAM</th>
                        <td>8 GB</td>
                    </tr>
                    <tr>
                        <th scope="row">Ổ cứng</th>
                        <td>256 GB SSD</td>
                    </tr>
                    <tr>
                        <th scope="row">Card đồ họa</th>
                        <td>7-core GPU</td>
                    </tr>
                    <tr>
                        <th scope="row">Cổng kết nối</th>
                        <td>2 x Thunderbolt 3 (USB-C), 3.5 mm</td>
                    </tr>
                    <tr>
                        <th scope="row">Hệ điều hành</th>
                        <td>Mac OS</td>
                    </tr>
                    <tr>
                        <th scope="row">Thiết kế</th>
                        <td>Vỏ kim loại nguyên khối</td>
                    </tr>
                    <tr>
                        <th scope="row">Trọng lượng</th>
                        <td>1.29 kg</td>
                    </tr>
                </tbody>
            </table>
            <button class="btn btn-outline-primary w-100 mt-3">Xem cấu hình chi tiết</button>
        </div>
    </div>
</div>

<!-- Đánh giá và bình luận -->
