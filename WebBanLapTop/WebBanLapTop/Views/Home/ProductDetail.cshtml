                    <button class="btn btn-light border border-danger p-2 text-center" style="width: 80px;">
                        <div class="rounded-circle mx-auto mb-1" style="width: 20px; height: 20px; background-color: #7D7E80;"></div>
                        <small>Space Gray</small>
                    </button>
                    <button class="btn btn-light border p-2 text-center" style="width: 80px;">
                        <div class="rounded-circle mx-auto mb-1" style="width: 20px; height: 20px; background-color: #E3CCB4;"></div>
                        <small>Gold</small>
                    </button>
                </div>
