            <div class="d-flex gap-2 mb-4">
                <button class="btn btn-danger btn-lg w-75 fw-bold text-uppercase py-3">Mua Ngay <br> <small class="fw-normal text-capitalize fs-6">Giao hàng miễn phí tận nơi</small></button>
