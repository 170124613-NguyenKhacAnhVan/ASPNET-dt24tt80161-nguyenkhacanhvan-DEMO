    </div>

    <div class="col-lg-6 col-md-12">
        <div class="bg-white p-4 rounded shadow-sm">
            <!-- Giá -->
            <div class="mb-4">
                <span class="fs-2 fw-bold text-danger">18.990.000đ</span>
                <span class="fs-5 text-muted text-decoration-line-through ms-3">22.990.000đ</span>
                <span class="badge bg-danger ms-2 align-top mt-2">Giảm 15%</span>
            </div>

            <!-- Ưu đãi -->
            <div class="border border-success rounded p-3 mb-4 bg-success bg-opacity-10">
                <h6 class="fw-bold text-success mb-2"><i class="bi bi-gift-fill me-2"></i> Khuyến mãi & Ưu đãi</h6>
                <ul class="list-unstyled mb-0">
                    <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i> Tặng Balo Laptop Đăng Khoa cao cấp</li>
                    <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i> Giảm thêm 5% (tối đa 500k) khi thanh toán qua VNPay</li>
                    <li><i class="bi bi-check-circle-fill text-success me-2"></i> Hỗ trợ trả góp 0% thẻ tín dụng</li>
                </ul>
            </div>

            <!-- Tùy chọn cấu hình -->
            <div class="mb-4">
                <h6 class="fw-bold mb-2">Tùy chọn phiên bản:</h6>
                <div class="d-flex gap-2">
                    <button class="btn btn-outline-danger active w-50">256GB<br><small>18.990.000đ</small></button>
                    <button class="btn btn-outline-secondary w-50">512GB<br><small>23.990.000đ</small></button>
                </div>
            </div>

            <!-- Tùy chọn màu sắc -->
            <div class="mb-4">
                <h6 class="fw-bold mb-2">Màu sắc:</h6>
