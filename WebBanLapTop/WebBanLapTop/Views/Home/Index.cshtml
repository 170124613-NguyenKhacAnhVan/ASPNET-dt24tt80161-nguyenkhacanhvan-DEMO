<!-- Hot Sale Section -->
<div class="hot-sale-section bg-danger rounded p-3 mb-4 shadow-sm">
    <div class="d-flex justify-content-between align-items-center mb-3 px-2">
        <h3 class="text-white fw-bold mb-0 text-uppercase"><i class="bi bi-lightning-charge-fill text-warning"></i> Khuyến Mãi Hot</h3>
        <a href="#" class="text-white text-decoration-none border border-white rounded px-3 py-1 bg-white bg-opacity-25 hover-white">Xem tất cả <i class="bi bi-chevron-right"></i></a>
    </div>
    <div class="row row-cols-2 row-cols-md-4 g-3">
        <!-- Product Card 1 -->
        <div class="col">
            <div class="card h-100 product-card border-0">
                <div class="badge bg-danger position-absolute top-0 start-0 m-2">Giảm 15%</div>
                <img src="https://images.unsplash.com/photo-1517336714731-489689fd1ca8?auto=format&fit=crop&w=300&h=300&q=80" class="card-img-top p-3" alt="MacBook Air M1">
                <div class="card-body pt-0">
                    <h5 class="card-title product-title fs-6">MacBook Air 13" 2020 M1 256GB</h5>
                    <div class="product-price">
                        <span class="text-danger fw-bold fs-5">18.990.000đ</span>
                        <br/>
                        <span class="text-decoration-line-through text-muted small">22.990.000đ</span>
                    </div>
                </div>
                <div class="card-footer bg-white border-0 pt-0">
                    <a href="#" class="btn btn-outline-danger w-100">Mua ngay</a>
                </div>
            </div>
        </div>
        <!-- Product Card 2 -->
        <div class="col">
            <div class="card h-100 product-card border-0">
                <div class="badge bg-danger position-absolute top-0 start-0 m-2">Giảm 20%</div>
                <img src="https://images.unsplash.com/photo-1593642632823-8f785ba67e45?auto=format&fit=crop&w=300&h=300&q=80" class="card-img-top p-3" alt="Dell XPS 13">
                <div class="card-body pt-0">
                    <h5 class="card-title product-title fs-6">Laptop Dell XPS 13 9315 (Core i5 1230U/ 8GB/ 512GB)</h5>
                    <div class="product-price">
                        <span class="text-danger fw-bold fs-5">25.490.000đ</span>
                        <br/>
                        <span class="text-decoration-line-through text-muted small">31.990.000đ</span>
                    </div>
                </div>
                <div class="card-footer bg-white border-0 pt-0">
                    <a href="#" class="btn btn-outline-danger w-100">Mua ngay</a>
                </div>
            </div>
        </div>
        <!-- Product Card 3 -->
        <div class="col">
            <div class="card h-100 product-card border-0">
                <div class="badge bg-danger position-absolute top-0 start-0 m-2">Giảm 10%</div>
                <img src="https://images.unsplash.com/photo-1603302576837-37561b2e2302?auto=format&fit=crop&w=300&h=300&q=80" class="card-img-top p-3" alt="Asus TUF Gaming">
                <div class="card-body pt-0">
                    <h5 class="card-title product-title fs-6">Laptop Asus TUF Gaming F15 FX507ZC4</h5>
